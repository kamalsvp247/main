# Vercel frontend/API variables
NODE_ENV=production
JWT_SECRET=replace-with-the-same-jwt-secret-as-railway
REFRESH_SECRET=replace-with-the-same-refresh-secret-as-railway

# Supabase public browser values
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional server-side Supabase access for Vercel API routes
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required: Vercel proxies SVP live-browser actions to Railway.
RAILWAY_BACKEND_URL=https://your-railway-app.up.railway.app
