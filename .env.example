# Shared app settings (Railway and Vercel)
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
REFRESH_SECRET=replace-with-a-second-long-random-secret

# Supabase (Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Railway browser/noVNC backend
RAILWAY_BACKEND_URL=https://your-railway-app.up.railway.app
NOVNC_PUBLIC_URL=https://your-novnc-domain.up.railway.app/vnc.html

# Optional SVP and OTP providers
SVP_BASE=https://svp-international.pacc.sa
SVP_API_BASE=https://svp-international-api.pacc.sa/api/v1
DAKBOX_API_URL=https://dakbox.net/api/v1
DAKBOX_API_KEY=
