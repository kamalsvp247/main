{
  "name": "t2hub",
  "version": "0.2.0",
  "private": true,
  "description": "T2Hub - SVP Exam Center Automation Platform with RBAC, Quota Management, and Agent System",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "node --experimental-specifier-resolution=node src/app/api/seed/route.js",
    "db:init": "node -e \"import('@/lib/db/index.js').then(m => m.initDb())\"",
    "db:seed": "npm run db:init && npm run seed",
    "svp-login": "node -e \"import('./src/lib/svp-playwright.js').then(m => m.login()).then(r => console.log(r)).catch(e => console.error(e))\"",
    "svp-upload": "node scripts/upload-svp-session.js"
  },
  "dependencies": {
    "@supabase/server": "^1.4.1",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/postcss": "^4",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "next": "^16.3.0",
    "playwright": "^1.62.0",
    "puppeteer": "^25.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "lowdb": "^7.0.1"
  }
}
