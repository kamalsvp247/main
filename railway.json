{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && npx playwright install chromium"
  },
  "deploy": {
    "startCommand": "supervisord -c /app/supervisord.conf",
    "healthcheckPath": "/api/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
